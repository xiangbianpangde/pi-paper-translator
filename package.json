{
  "name": "pi-paper-translator",
  "version": "0.1.0",
  "description": "Pi extension for batch MinerU OCR, MiniMax paper translation, and Obsidian-ready output",
  "license": "MIT",
  "keywords": ["pi-package", "pdf", "mineru", "minimax", "obsidian", "academic-translation"],
  "repository": {
    "type": "git",
